# ============================================================
# LeitorDeDocs — Configuração do Provedor de IA
# ============================================================
# Copie este arquivo para .env e preencha os valores desejados.
# Escolha UM provedor abaixo e configure apenas as variáveis dele.
# ============================================================

# Provedor ativo: gemini | groq | ollama
AI_PROVIDER=groq

# ------------------------------------------------------------
# OPÇÃO 1 — Google Gemini
# Obtenha sua chave em: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------
GEMINI_API_KEY=

# ------------------------------------------------------------
# OPÇÃO 2 — Groq (Llama na nuvem) ← RECOMENDADO PARA LLAMA
# Obtenha sua chave GRATUITA em: https://console.groq.com
# Modelos disponíveis com visão:
#   llama-3.2-90b-vision-preview  (mais preciso)
#   llama-3.2-11b-vision-preview  (mais rápido, padrão)
# ------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.2-11b-vision-preview

# ------------------------------------------------------------
# OPÇÃO 3 — Ollama (Llama local, sem internet, sem custo)
# Instale em: https://ollama.com
# Depois execute: ollama pull llama3.2-vision
# Modelos com suporte a visão: llama3.2-vision, llava, minicpm-v
# ------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2-vision
